{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AT Video",
  "version": "0.1.0-alpha.0",
  "identifier": "com.attson.video",
  "build": {
    "beforeDevCommand": "pnpm stage:service && pnpm dev",
    "devUrl": "http://127.0.0.1:1428",
    "beforeBuildCommand": "pnpm build && pnpm stage:service --release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "视频链接抽取",
        "width": 1120,
        "height": 800,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "nsis"],
    "externalBin": [
      "binaries/atvideo-service",
      "binaries/youtube-bridge",
      "binaries/qjs"
    ],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../licenses/QuickJS-ng-MIT.txt": "licenses/QuickJS-ng-MIT.txt",
      "../licenses/yt-dlp-UNLICENSE.txt": "licenses/yt-dlp-UNLICENSE.txt",
      "../licenses/yt-dlp-ejs-LICENSE.txt": "licenses/yt-dlp-ejs-LICENSE.txt",
      "../runtime-manifest.json": "runtime-manifest.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
